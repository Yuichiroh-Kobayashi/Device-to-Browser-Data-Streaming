{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:d2b-stream:0.1:server-message",
  "title": "d2b-stream 0.1 server control message",
  "description": "One complete UTF-8 JSON WebSocket text message sent by a server.",
  "oneOf": [
    {
      "$ref": "#/$defs/welcome"
    },
    {
      "$ref": "#/$defs/streamStarted"
    },
    {
      "$ref": "#/$defs/streamStopped"
    },
    {
      "$ref": "#/$defs/status"
    },
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/pong"
    }
  ],
  "$defs": {
    "uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "safeUnsignedInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "streamId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "correlation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "streamParameters": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "properties": {
        "sample_format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "channel_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "channel_mask": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "sample_rate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "denominator": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        },
        "samples_per_frame": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "additionalProperties": true
    },
    "errorCode": {
      "enum": [
        "busy",
        "unauthorized",
        "unknown_stream",
        "unsupported_version",
        "unsupported_profile",
        "unsupported_parameters",
        "invalid_message",
        "invalid_state",
        "frame_too_large",
        "internal_error"
      ]
    },
    "errorDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/errorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "welcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol",
        "version",
        "max_control_message_size",
        "max_binary_frame_size",
        "session_state"
      ],
      "properties": {
        "type": {
          "const": "welcome"
        },
        "protocol": {
          "const": "d2b-stream"
        },
        "version": {
          "const": "0.1"
        },
        "max_control_message_size": {
          "const": 2048
        },
        "max_binary_frame_size": {
          "type": "integer",
          "minimum": 32,
          "maximum": 4294967295
        },
        "session_state": {
          "const": "ready"
        },
        "server_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "streamStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "stream",
        "profile",
        "parameters",
        "stream_id"
      ],
      "properties": {
        "type": {
          "const": "stream_started"
        },
        "stream": {
          "$ref": "#/$defs/identifier"
        },
        "profile": {
          "$ref": "#/$defs/identifier"
        },
        "parameters": {
          "$ref": "#/$defs/streamParameters"
        },
        "stream_id": {
          "$ref": "#/$defs/streamId"
        }
      }
    },
    "streamStopped": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "stream_id",
        "reason"
      ],
      "properties": {
        "type": {
          "const": "stream_stopped"
        },
        "stream_id": {
          "$ref": "#/$defs/streamId"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "state",
        "connected_client_count",
        "producer_drop_count",
        "output_queue_drop_count",
        "queued_sample_count",
        "source_paused",
        "uptime_us"
      ],
      "properties": {
        "type": {
          "const": "status"
        },
        "state": {
          "enum": [
            "idle",
            "streaming"
          ]
        },
        "active_stream_id": {
          "$ref": "#/$defs/streamId"
        },
        "connected_client_count": {
          "$ref": "#/$defs/uint32"
        },
        "producer_drop_count": {
          "$ref": "#/$defs/safeUnsignedInteger"
        },
        "output_queue_drop_count": {
          "$ref": "#/$defs/safeUnsignedInteger"
        },
        "queued_sample_count": {
          "$ref": "#/$defs/uint32"
        },
        "source_paused": {
          "type": "boolean"
        },
        "uptime_us": {
          "$ref": "#/$defs/safeUnsignedInteger"
        },
        "last_error": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/errorDetail"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "streaming"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "active_stream_id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "active_stream_id"
              ]
            }
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "code",
        "message"
      ],
      "properties": {
        "type": {
          "const": "error"
        },
        "code": {
          "$ref": "#/$defs/errorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "correlation": {
          "$ref": "#/$defs/correlation"
        },
        "recoverable": {
          "type": "boolean"
        }
      }
    },
    "pong": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "correlation"
      ],
      "properties": {
        "type": {
          "const": "pong"
        },
        "correlation": {
          "$ref": "#/$defs/correlation"
        }
      }
    }
  }
}
