{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:d2b-stream:0.1:client-message",
  "title": "d2b-stream 0.1 client control message",
  "description": "One complete UTF-8 JSON WebSocket text message sent by a client.",
  "oneOf": [
    {
      "$ref": "#/$defs/hello"
    },
    {
      "$ref": "#/$defs/startStream"
    },
    {
      "$ref": "#/$defs/stopStream"
    },
    {
      "$ref": "#/$defs/ping"
    }
  ],
  "$defs": {
    "streamId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "correlation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "streamParameters": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "properties": {
        "sample_format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "channel_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "channel_mask": {
          "$ref": "#/$defs/uint32"
        },
        "sample_rate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "$ref": "#/$defs/uint32"
            },
            "denominator": {
              "$ref": "#/$defs/uint32"
            }
          }
        },
        "samples_per_frame": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "additionalProperties": true
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "token"
      ],
      "properties": {
        "scheme": {
          "const": "pairing-token"
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "An opaque token of 1 through 256 UTF-8 bytes; byte length is enforced by the receiver."
        }
      }
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol",
        "versions"
      ],
      "properties": {
        "type": {
          "const": "hello"
        },
        "protocol": {
          "const": "d2b-stream"
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          }
        },
        "client_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "authentication": {
          "$ref": "#/$defs/authentication"
        }
      }
    },
    "startStream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "stream",
        "profile",
        "parameters"
      ],
      "properties": {
        "type": {
          "const": "start_stream"
        },
        "stream": {
          "$ref": "#/$defs/identifier"
        },
        "profile": {
          "$ref": "#/$defs/identifier"
        },
        "parameters": {
          "$ref": "#/$defs/streamParameters"
        },
        "options": {
          "type": "object",
          "maxProperties": 32
        }
      }
    },
    "stopStream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "stop_stream"
        },
        "stream_id": {
          "$ref": "#/$defs/streamId"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "ping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "correlation"
      ],
      "properties": {
        "type": {
          "const": "ping"
        },
        "correlation": {
          "$ref": "#/$defs/correlation"
        }
      }
    }
  }
}
