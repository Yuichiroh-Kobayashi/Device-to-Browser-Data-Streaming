      "direction": "client_to_server",
      "message": {
        "type": "start_stream",
        "stream": "measurement-0",
        "profile": "vi-measurement",
        "parameters": {
          "sample_format": "vi-f32le",
          "channel_count": 2,
          "channel_mask": 3,
          "sample_rate": {
            "numerator": 0,
            "denominator": 0
          }
        }
      },
      "expected_valid": true,
      "context": {
        "state": "READY",
        "owns_stream": false
      },
      "expected_decoded": {
        "type": "start_stream",
        "stream": "measurement-0",
        "profile": "vi-measurement",
        "parameters": {
          "sample_format": "vi-f32le",
          "channel_count": 2,
          "channel_mask": 3,
          "sample_rate": {
            "numerator": 0,
            "denominator": 0
          }
        }
      }
    },
