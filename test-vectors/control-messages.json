    {
      "name": "duplicate_json_key",
      "purpose": "Reject duplicate object keys.",
      "direction": "client_to_server",
      "message": "{\"type\":\"ping\",\"correlation\":\"a\",\"correlation\":\"b\"}",
      "expected_valid": false,
      "expected_error": "invalid_message"
    },
    {
      "name": "json_nan",
