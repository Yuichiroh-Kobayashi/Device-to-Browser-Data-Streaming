      "expected_valid": true,
      "expected_decoded": {
        "type": "status",
        "state": "streaming",
        "active_stream_id": 7,
        "connected_client_count": 1,
        "producer_drop_count": 2,
        "output_queue_drop_count": 3,
        "queued_sample_count": 8,
        "source_paused": false,
        "uptime_us": 123456
      }
    },
    {
      "name": "server_unsupported_profile",
      "purpose": "Represent explicit unknown-profile rejection.",
      "direction": "server_to_client",
      "message": {
        "type": "error",
        "code": "unsupported_profile",
        "message": "profile is not supported",
        "recoverable": true
      },
      "expected_valid": true,
      "expected_decoded": {
        "type": "error",
        "code": "unsupported_profile",
        "message": "profile is not supported",
        "recoverable": true
      }
    },
    {
      "name": "unsupported_profile",
      "purpose": "Reject an unknown profile without fallback.",
      "direction": "client_to_server",
      "message": {
        "type": "start_stream",
        "stream": "x",
        "profile": "com.example.private",
        "parameters": {}
      },
      "expected_valid": false,
      "expected_error": "unsupported_profile"
    },
    {
      "name": "invalid_channel_mask",
      "purpose": "Reject impossible PCM channel count/mask combinations.",
      "direction": "client_to_server",
      "message": {
        "type": "start_stream",
        "stream": "audio-0",
        "profile": "pcm-audio",
        "parameters": {
          "sample_format": "pcm-s16le-interleaved",
          "channel_count": 2,
          "channel_mask": 1,
          "sample_rate": {
            "numerator": 16000,
            "denominator": 1
          },
          "samples_per_frame": 256
