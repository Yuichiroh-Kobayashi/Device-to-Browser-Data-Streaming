    {
      "name": "server_status",
      "purpose": "Accept detailed authenticated control status.",
      "direction": "server_to_client",
      "message": {
        "type": "status",
        "state": "streaming",
        "active_stream_id": 7,
        "connected_client_count": 1,
        "producer_drop_count": 2,
        "output_queue_drop_count": 3,
        "queued_sample_count": 8,
        "source_paused": false,
        "uptime_us": 123456
