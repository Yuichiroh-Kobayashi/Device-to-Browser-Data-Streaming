{
  "format": "d2b-stream-test-vectors/0.1",
  "protocol": "d2b-stream",
  "version": "0.1",
  "vectors": [
    {
      "name": "client_hello",
      "purpose": "Accept version negotiation.",
      "direction": "client_to_server",
      "message": {
        "type": "hello",
        "protocol": "d2b-stream",
        "versions": [
          "0.1"
        ]
      },
      "expected_valid": true,
      "context": {
        "state": "CONNECTED",
        "owns_stream": false
      },
      "expected_decoded": {
        "type": "hello",
        "protocol": "d2b-stream",
        "versions": [
          "0.1"
        ]
      }
    },
    {
      "name": "client_hello_pairing",
      "purpose": "Accept pairing-token authentication.",
      "direction": "client_to_server",
      "message": {
        "type": "hello",
        "protocol": "d2b-stream",
        "versions": [
          "0.1"
        ],
        "authentication": {
          "scheme": "pairing-token",
          "token": "classroom-token"
        }
      },
      "expected_valid": true,
      "expected_decoded": {
        "type": "hello",
        "protocol": "d2b-stream",
        "versions": [
          "0.1"
        ],
        "authentication": {
          "scheme": "pairing-token",
          "token": "classroom-token"
        }
      }
    },
    {
      "name": "server_welcome",
      "purpose": "Accept the negotiated limits.",
      "direction": "server_to_client",
      "message": {
        "type": "welcome",
        "protocol": "d2b-stream",
        "version": "0.1",
        "max_control_message_size": 2048,
        "max_binary_frame_size": 65536,
        "session_state": "ready"
      },
      "expected_valid": true,
      "expected_decoded": {
        "type": "welcome",
        "protocol": "d2b-stream",
        "version": "0.1",
        "max_control_message_size": 2048,
        "max_binary_frame_size": 65536,
        "session_state": "ready"
      }
    },
