        "type": "stream_started",
        "stream": "audio-0",
        "profile": "pcm-audio",
        "parameters": {
          "sample_format": "pcm-s16le-interleaved",
          "channel_count": 1,
          "channel_mask": 1,
          "sample_rate": {
            "numerator": 16000,
            "denominator": 1
          },
          "samples_per_frame": 256
        },
        "stream_id": 7
      }
    },
    {
      "name": "client_stop",
      "purpose": "Accept a targeted stop.",
      "direction": "client_to_server",
      "message": {
        "type": "stop_stream",
        "stream_id": 7,
        "reason": "capture complete"
      },
      "expected_valid": true,
      "context": {
        "state": "STREAMING",
        "owns_stream": true
      },
      "expected_decoded": {
        "type": "stop_stream",
        "stream_id": 7,
        "reason": "capture complete"
      }
    },
    {
      "name": "server_stopped",
      "purpose": "Accept stream completion.",
      "direction": "server_to_client",
      "message": {
        "type": "stream_stopped",
        "stream_id": 7,
        "reason": "capture complete"
      },
      "expected_valid": true,
      "expected_decoded": {
        "type": "stream_stopped",
        "stream_id": 7,
        "reason": "capture complete"
      }
    },
    {
      "name": "client_ping",
      "purpose": "Accept a ping.",
      "direction": "client_to_server",
      "message": {
        "type": "ping",
        "correlation": "p-1"
      },
      "expected_valid": true,
      "expected_decoded": {
        "type": "ping",
        "correlation": "p-1"
      }
    },
    {
      "name": "server_pong",
      "purpose": "Accept the matching pong shape.",
      "direction": "server_to_client",
      "message": {
        "type": "pong",
        "correlation": "p-1"
      },
      "expected_valid": true,
      "expected_decoded": {
        "type": "pong",
        "correlation": "p-1"
      }
